# Pipeline 6 — atlas executor env. Copy to .env.atlas and fill in real values.
# .env.atlas is gitignored. Loaded automatically by the pipeline-6 scripts.

# Required — internal PQS bearer token. Sent as Authorization: Bearer <token>.
# Bypasses the x402 paywall on /api/score and authenticates /api/score-output.
PQS_INTERNAL_BEARER=PQS_your_internal_bearer_token

# Required — Anthropic key for the Haiku 4.5 generator and cloud judge.
ANTHROPIC_API_KEY=sk-ant-your_key

# Optional — X-PQS-Internal observability flag. When set, atlas traffic is
# flagged is_internal=true in pqs_api_calls.
# PQS_INTERNAL_TOKEN=your_internal_attribution_token

# Optional overrides — defaults shown.
# PQS_PROMPT_SCORE_URL=https://pqs.onchainintel.net/api/score
# PQS_OUTPUT_SCORE_URL=https://pqs.onchainintel.net/api/score-output
# Until Session A's /api/score-output is deployed, point at local dev:
# PQS_OUTPUT_SCORE_URL=http://localhost:3000/api/score-output

# OLLAMA_HOST=http://192.168.1.205:11434
# OLLAMA_MODEL=gemma2:9b

# Set this to the real software-vertical corpus path before running.
# PQS_SOURCE_CORPUS=pipelines/pipeline-4/outputs/source-corpus-software.jsonl
# PQS_ATLAS_OUTPUT=pipelines/pipeline-6/outputs/atlas-software.jsonl
