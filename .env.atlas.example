# Pipeline 6 — atlas executor env. Copy to .env.atlas and fill in real values.
# .env.atlas is gitignored. Loaded automatically by the pipeline-6 scripts.

# Required — internal PQS token. Sent as Authorization: Bearer <token>; bypasses
# the x402 paywall on /api/score and authenticates /api/score-output. Also sent
# as the X-PQS-Internal flag so atlas traffic is is_internal=true in pqs_api_calls.
PQS_INTERNAL_TOKEN=PQS_your_internal_token

# Required — Anthropic key for the Haiku 4.5 generator and cloud judge.
ANTHROPIC_API_KEY=sk-ant-your_key

# Optional overrides — defaults shown.
# PQS_PROMPT_SCORE_URL=https://pqs.onchainintel.net/api/score
# PQS_OUTPUT_SCORE_URL=https://pqs.onchainintel.net/api/score-output
# For local dev, point /api/score-output at a dev server:
# PQS_OUTPUT_SCORE_URL=http://localhost:3000/api/score-output

# OLLAMA_HOST=http://192.168.1.205:11434
# OLLAMA_MODEL=gemma2:9b

# Override the input corpus / atlas output path — defaults shown.
# PQS_SOURCE_CORPUS=data/source-prompts-clean-deterministic.jsonl
# PQS_ATLAS_OUTPUT=scripts/pipeline-6/outputs/atlas-software.jsonl
